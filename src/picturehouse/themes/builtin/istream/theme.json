{
  "schema": 1,
  "id": "istream",
  "name": "iStream",
  "version": "2.0.0",
  "author": "PictureHouse",
  "description": "Liquid glass, inspired by Apple TV: floating glass controls over edge-to-edge artwork, the page tinted by what's on screen, and soft, springy motion.",
  "scheme": "dark",
  "layout": { "nav": "floating", "hero": "full-bleed" },
  "tokens": {
    "color.background": "#050507",
    "color.navigation": "rgba(28, 28, 34, 0.42)",
    "color.surface": "rgba(255, 255, 255, 0.07)",
    "color.surface-raised": "rgba(40, 40, 48, 0.66)",
    "color.line": "rgba(255, 255, 255, 0.14)",
    "color.text": "#f5f5f7",
    "color.text-muted": "rgba(235, 235, 245, 0.64)",
    "color.text-faint": "rgba(235, 235, 245, 0.34)",
    "color.accent": "#ffffff",
    "color.on-accent": "#000000",
    "color.good": "#30d158",
    "color.info": "#64d2ff",
    "color.warning": "#ff9f0a",
    "color.error": "#ff453a",
    "font.display": "-apple-system, BlinkMacSystemFont, \"SF Pro Display\", \"Helvetica Neue\", \"Segoe UI Variable Display\", \"Segoe UI\", Roboto, sans-serif",
    "font.body": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Helvetica Neue\", \"Segoe UI Variable Text\", \"Segoe UI\", Roboto, sans-serif",
    "font.mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, monospace",
    "size.gutter": "clamp(18px, 4vw, 64px)",
    "size.navigation": "52px",
    "radius.card": "18px",
    "radius.button": "999px",
    "radius.panel": "26px",
    "radius.hero": "30px"
  },
  "tv": {
    "tokens": {
      "color.surface": "#1c1c1e",
      "color.surface-raised": "#2c2c2e",
      "color.line": "rgba(255, 255, 255, 0.12)"
    }
  },
  "stylesheet": "theme.css"
}
