{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PictureHouse",
  "version": "0.1.0",
  "identifier": "com.picturehouse.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "publisher": "PictureHouse",
    "shortDescription": "Home media server",
    "longDescription": "PictureHouse serves your films, TV, music and photos to TVs (DLNA), browsers, phones and Chromecast.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/picturehouse-server/": "server/"
    },
    "category": "Video",
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg"
        ],
        "section": "video"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
